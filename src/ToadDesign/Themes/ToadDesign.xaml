<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared values of every theme root. Colours live in the per-root colour dictionary (Palette.cs), sizes in the per-root size dictionary (Metrics.cs). -->

    <FontFamily x:Key="Toad.FontFamily">Segoe UI</FontFamily>

    <CornerRadius x:Key="Toad.Radius.Window">10</CornerRadius>
    <CornerRadius x:Key="Toad.Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Toad.Radius.Item">6</CornerRadius>
    <CornerRadius x:Key="Toad.Radius.Check">5</CornerRadius>

    <Duration x:Key="Toad.Duration.Hover">0:0:0.12</Duration>

</ResourceDictionary>
