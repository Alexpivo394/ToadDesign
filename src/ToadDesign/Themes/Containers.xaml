<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ToadDesign">

    <!-- Header row shared by Card and CardExpander: 36 px light-accent icon tile, bold header, dimmed description. -->
    <DataTemplate x:Key="Toad.Template.CardTitle">
        <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>

    <Style x:Key="Toad.Style.Card" TargetType="local:Card">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Card">
                    <Border CornerRadius="{DynamicResource Toad.Radius.Window}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Grid x:Name="HeaderRow" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconTile" Width="36" Height="36" CornerRadius="{DynamicResource Toad.Radius.Control}" Margin="0,0,14,0"
                                        Background="{DynamicResource Toad.Brush.AccentLight}" VerticalAlignment="Center">
                                    <local:Icon Symbol="{TemplateBinding Icon}" Width="20" Height="20" Foreground="{DynamicResource Toad.Brush.AccentLightText}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{StaticResource Toad.Template.CardTitle}" RecognizesAccessKey="False"/>
                                    <ContentPresenter x:Name="DescriptionText" Content="{TemplateBinding Description}" RecognizesAccessKey="False"
                                                      TextElement.FontSize="{DynamicResource Toad.FontSize.Small}" TextElement.Foreground="{DynamicResource Toad.Brush.TextDimmed}">
                                        <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding TrailingContent}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                            <ContentPresenter x:Name="Body" RecognizesAccessKey="False"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasContent" Value="True"/>
                                <Condition SourceName="HeaderRow" Property="Visibility" Value="Visible"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Body" Property="Margin" Value="0,12,0,0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:Card" BasedOn="{StaticResource Toad.Style.Card}"/>

    <Style x:Key="Toad.Style.CardExpanderHeader" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="16,14">
                        <ContentPresenter RecognizesAccessKey="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toad.Style.CardExpander" TargetType="local:CardExpander">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,0,16,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CardExpander">
                    <Border CornerRadius="{DynamicResource Toad.Radius.Window}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource Toad.Style.CardExpanderHeader}" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="IconTile" Width="36" Height="36" CornerRadius="{DynamicResource Toad.Radius.Control}" Margin="0,0,14,0"
                                            Background="{DynamicResource Toad.Brush.AccentLight}">
                                        <local:Icon Symbol="{Binding Icon, RelativeSource={RelativeSource AncestorType=local:CardExpander}}" Width="20" Height="20"
                                                    Foreground="{DynamicResource Toad.Brush.AccentLightText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=local:CardExpander}}"
                                                          ContentTemplate="{StaticResource Toad.Template.CardTitle}" RecognizesAccessKey="False"/>
                                        <ContentPresenter x:Name="DescriptionText" Content="{Binding Description, RelativeSource={RelativeSource AncestorType=local:CardExpander}}" RecognizesAccessKey="False"
                                                          TextElement.FontSize="{DynamicResource Toad.FontSize.Small}" TextElement.Foreground="{DynamicResource Toad.Brush.TextDimmed}">
                                            <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" Content="{Binding TrailingContent, RelativeSource={RelativeSource AncestorType=local:CardExpander}}"
                                                      VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <local:Icon x:Name="Chevron" Grid.Column="3" Symbol="ChevronDown" Width="16" Height="16" Margin="14,0,0,0" RenderTransformOrigin="0.5,0.5"
                                                Foreground="{DynamicResource Toad.Brush.TextDimmed}">
                                        <local:Icon.RenderTransform><RotateTransform Angle="0"/></local:Icon.RenderTransform>
                                    </local:Icon>
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CardExpander" BasedOn="{StaticResource Toad.Style.CardExpander}"/>

    <!-- Alert: light background of the severity, 20 px icon, bold title in the severity colour, body in text colour. -->
    <Style x:Key="Toad.Style.AlertClose" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Item}" Background="Transparent">
                        <local:Icon Symbol="X" Width="14" Height="14" Foreground="{DynamicResource Toad.Brush.TextDimmed}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toad.Style.Alert" TargetType="local:Alert">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.InfoLight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Info}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Alert">
                    <Border CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:Icon x:Name="SeverityIcon" Symbol="InfoCircle" Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                        Foreground="{TemplateBinding BorderBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontWeight="Bold" Foreground="{TemplateBinding BorderBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <ContentPresenter RecognizesAccessKey="False">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <Button x:Name="PART_Close" Grid.Column="2" Style="{StaticResource Toad.Style.AlertClose}" Margin="12,-2,-4,0" VerticalAlignment="Top"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="SeverityIcon" Property="Symbol" Value="CircleCheck"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="SeverityIcon" Property="Symbol" Value="AlertTriangle"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="SeverityIcon" Property="Symbol" Value="AlertCircle"/>
                        </Trigger>
                        <Trigger Property="IsClosable" Value="True">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.AccentLight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.AccentLightText}"/>
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.WarningLight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Warning}"/>
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.DangerLight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:Alert" BasedOn="{StaticResource Toad.Style.Alert}"/>

    <!-- Badge: 22 px pill, 11 px bold upper case. -->
    <local:UpperCaseConverter x:Key="Toad.Converter.BadgeUpper"/>
    <local:CaptionTemplateSelector x:Key="Toad.Selector.Badge">
        <local:CaptionTemplateSelector.Caption>
            <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource Toad.Converter.BadgeUpper}}" FontSize="11" FontWeight="Bold"/>
            </DataTemplate>
        </local:CaptionTemplateSelector.Caption>
    </local:CaptionTemplateSelector>

    <Style x:Key="Toad.Style.Badge" TargetType="local:Badge">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.AccentLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.AccentLightText}"/>
        <Setter Property="ContentTemplateSelector" Value="{StaticResource Toad.Selector.Badge}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Badge">
                    <Border CornerRadius="11" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="local:Theme.Tone" Value="Neutral">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
            </Trigger>
            <Trigger Property="local:Theme.Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.WarningLight}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Warning}"/>
            </Trigger>
            <Trigger Property="local:Theme.Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.DangerLight}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Danger}"/>
            </Trigger>
            <Trigger Property="local:Theme.Tone" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.InfoLight}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Info}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:Badge" BasedOn="{StaticResource Toad.Style.Badge}"/>

    <!-- Loader: a quarter accent arc over a faint track, one turn per 0.8 s. -->
    <Style x:Key="Toad.Style.Loader" TargetType="local:Loader">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Loader">
                    <Viewbox>
                        <Grid x:Name="Arc" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform Angle="0"/></Grid.RenderTransform>
                            <Ellipse Margin="2" Stroke="{DynamicResource Toad.Brush.AccentLight}" StrokeThickness="2.5"/>
                            <Path Data="M 12,2 A 10,10 0 0 1 22,12" Stroke="{DynamicResource Toad.Brush.Accent}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive" Value="True"/>
                                <Condition Property="IsVisible" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="Spin">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Arc" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin"/>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsActive" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:Loader" BasedOn="{StaticResource Toad.Style.Loader}"/>

    <!-- AutoSuggestBox: the toad:TextBox look plus a suggestions card under it. -->
    <Style x:Key="Toad.Style.SuggestionList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" MaxHeight="300">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toad.Style.AutoSuggestBox" TargetType="local:AutoSuggestBox">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="{DynamicResource Toad.Size.Control}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Toad.Brush.Accent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Icon" Value="Search"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AutoSuggestBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon x:Name="PART_Icon" Symbol="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Foreground="{DynamicResource Toad.Brush.TextDimmed}"/>
                                <TextBlock x:Name="PART_Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" Visibility="Collapsed" Margin="2,0,0,0"
                                           Foreground="{DynamicResource Toad.Brush.TextDimmed}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding TrailingContent}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False" PopupAnimation="Fade" StaysOpen="False"
                               IsOpen="{Binding IsSuggestionListOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Margin="0,0,10,16">
                                <Border Margin="0,4,0,0" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="Black"
                                        Opacity="{DynamicResource Toad.Shadow.MenuOpacity}">
                                    <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
                                    <Border.RenderTransform><TranslateTransform Y="5"/></Border.RenderTransform>
                                </Border>
                                <Border x:Name="SuggestionsBorder" Margin="0,4,0,0" Padding="4" CornerRadius="{DynamicResource Toad.Radius.Control}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource Toad.Brush.Surface}" BorderBrush="{DynamicResource Toad.Brush.Border}" BorderThickness="1">
                                    <ListBox x:Name="PART_Suggestions" Style="{StaticResource Toad.Style.SuggestionList}"
                                             ItemsSource="{TemplateBinding Suggestions}" DisplayMemberPath="{TemplateBinding DisplayMemberPath}"/>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource Toad.Template.NoValidationAdorner}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:AutoSuggestBox" BasedOn="{StaticResource Toad.Style.AutoSuggestBox}"/>

</ResourceDictionary>
