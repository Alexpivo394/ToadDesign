<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ToadDesign">

    <!-- Keyboard focus ring: 2 px accent, 3 px outside the control (shown by WPF for keyboard focus only). -->
    <Style x:Key="Toad.Style.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Toad.Brush.Focus}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared button chrome: background, hover layer (120 ms fade), 1 px press shift, preview states, focus ring. -->
    <ControlTemplate x:Key="Toad.Template.Button" TargetType="ButtonBase">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="HoverLayer" CornerRadius="{DynamicResource Toad.Radius.Control}" Opacity="0"
                    Background="{DynamicResource Toad.Brush.Hover}"/>
            <Border x:Name="PreviewRing" Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Toad.Brush.Focus}" Visibility="Collapsed"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" Focusable="False"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="local:Theme.PreviewState" Value="Hover">
                <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="local:Theme.PreviewState" Value="Pressed">
                <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="local:Theme.PreviewState" Value="Focus">
                <Setter TargetName="PreviewRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Toad.Style.ButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource Toad.Size.Control}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Toad.Style.FocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource Toad.Template.Button}"/>
    </Style>

    <!-- Standard Button = the Default variant. -->
    <Style x:Key="Toad.Style.Button" TargetType="Button" BasedOn="{StaticResource Toad.Style.ButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.Track}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Track}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Toad.Style.Button}"/>

    <!-- ToggleButton: Default look, light accent when checked. -->
    <Style x:Key="Toad.Style.ToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource Toad.Style.ButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.AccentLight}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.AccentLightText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.Track}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Track}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Toad.Style.ToggleButton}"/>

    <!-- toad:Button: Variant × Tone. The colours come from ToneBrushes (set by Button.UpdateTone); triggers here only add
         hover, press, preview and disabled. -->
    <Style x:Key="Toad.Style.ToadButton" TargetType="local:Button" BasedOn="{StaticResource Toad.Style.ButtonBase}">
        <Setter Property="Background" Value="{Binding Path=(local:ToneBrushes.Background), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="BorderBrush" Value="{Binding Path=(local:ToneBrushes.Border), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{Binding Path=(local:ToneBrushes.Foreground), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Button">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="HoverLayer" CornerRadius="{DynamicResource Toad.Radius.Control}" Opacity="0"
                                Background="{Binding Path=(local:ToneBrushes.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border x:Name="PreviewRing" Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Toad.Brush.Focus}" Visibility="Collapsed"/>
                        <DockPanel Margin="{TemplateBinding Padding}" LastChildFill="True"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <local:Icon x:Name="IconPart" DockPanel.Dock="Left" Symbol="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="ContentPart" RecognizesAccessKey="False" Focusable="False" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsIconOnly" Value="True">
                            <Setter TargetName="IconPart" Property="Margin" Value="0"/>
                            <Setter TargetName="ContentPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Hover">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Pressed">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Focus">
                            <Setter TargetName="PreviewRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{Binding Path=(local:ToneBrushes.HoverForeground), RelativeSource={RelativeSource Self}}"/>
            </Trigger>
            <Trigger Property="local:Theme.PreviewState" Value="Hover">
                <Setter Property="Foreground" Value="{Binding Path=(local:ToneBrushes.HoverForeground), RelativeSource={RelativeSource Self}}"/>
            </Trigger>
            <Trigger Property="IsIconOnly" Value="True">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="{DynamicResource Toad.Size.Control}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.Track}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Track}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="local:Button" BasedOn="{StaticResource Toad.Style.ToadButton}"/>

</ResourceDictionary>
