<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ToadDesign">

    <!-- Card of menus and submenus: surface, border, radius 10, padding 5, soft shadow (the mockup menu shadow). -->
    <ControlTemplate x:Key="Toad.Template.MenuCard" TargetType="ContentControl">
        <Grid Margin="0,0,12,16">
            <Border CornerRadius="10" Background="Black" Opacity="{DynamicResource Toad.Shadow.MenuOpacity}">
                <Border.Effect><BlurEffect Radius="20"/></Border.Effect>
                <Border.RenderTransform><TranslateTransform Y="6"/></Border.RenderTransform>
            </Border>
            <Border CornerRadius="10" Padding="5" Background="{DynamicResource Toad.Brush.Surface}"
                    BorderBrush="{DynamicResource Toad.Brush.Border}" BorderThickness="1">
                <ContentPresenter/>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Toad.Style.ContextMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Border}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="0,0,12,16">
                        <Border CornerRadius="10" Background="Black" Opacity="{DynamicResource Toad.Shadow.MenuOpacity}">
                            <Border.Effect><BlurEffect Radius="20"/></Border.Effect>
                            <Border.RenderTransform><TranslateTransform Y="6"/></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="10" Padding="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer CanContentScroll="True" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource Toad.Style.ContextMenu}"/>

    <!-- Menu items: icon column (dimmed 16 px), header, gesture text, submenu chevron; radius 6, padding 7×10. -->
    <Style x:Key="Toad.Style.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Item}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToadMenuIcon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToadMenuGesture"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconPart" ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource Toad.Brush.TextDimmed}"/>
                                <local:Icon x:Name="CheckMark" Symbol="Check" Width="16" Height="16" Margin="0,0,10,0" Visibility="Collapsed"
                                            Foreground="{DynamicResource Toad.Brush.Accent}"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                           Foreground="{DynamicResource Toad.Brush.TextDimmed}" FontSize="{DynamicResource Toad.FontSize.Small}" VerticalAlignment="Center"/>
                                <local:Icon x:Name="Arrow" Grid.Column="3" Symbol="ChevronRight" Width="14" Height="14" Margin="12,0,0,0" Visibility="Collapsed"
                                            Foreground="{DynamicResource Toad.Brush.TextDimmed}"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-6" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                            <ContentControl Template="{StaticResource Toad.Template.MenuCard}" MinWidth="180" Grid.IsSharedSizeScope="True">
                                <ScrollViewer CanContentScroll="True" Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCheckable" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0"/>
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="2"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Hover">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="local:Theme.Tone" Value="Danger">
                            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Danger}"/>
                            <Setter TargetName="IconPart" Property="TextElement.Foreground" Value="{DynamicResource Toad.Brush.Danger}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource Toad.Style.MenuItem}"/>

    <Style x:Key="Toad.Style.Separator" TargetType="Separator">
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Toad.Brush.Border}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource Toad.Style.Separator}"/>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource Toad.Style.Separator}"/>

    <!-- Menu bar (not in the mockups): transparent, the same items. -->
    <Style x:Key="Toad.Style.Menu" TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
    </Style>
    <Style TargetType="Menu" BasedOn="{StaticResource Toad.Style.Menu}"/>

    <!-- ToolTip: inverted (dark on light theme, light on dark), radius 6, 12 px text. -->
    <Style x:Key="Toad.Style.ToolTip" TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="{DynamicResource Toad.Radius.Item}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" MaxWidth="360">
                        <ContentPresenter RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource Toad.Style.ToolTip}"/>

</ResourceDictionary>
