<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:ToadDesign">

    <!-- Caption buttons: 46×40, dimmed 15 px icons with stroke 1.5; hover background, close turns red. -->
    <Style x:Key="Toad.Style.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toad.Style.CloseButton" TargetType="Button" BasedOn="{StaticResource Toad.Style.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Toad.Brush.CloseHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toad.Style.CaptionIcon" TargetType="local:Icon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>

    <BooleanToVisibilityConverter x:Key="Toad.BooleanToVisibility"/>

    <Style TargetType="local:ToadWindow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToadWindow">
                    <Grid>
                        <Border x:Name="PART_Frame" CornerRadius="{DynamicResource Toad.Radius.Window}"
                                Background="{DynamicResource Toad.Brush.Surface}"
                                BorderBrush="{DynamicResource Toad.Brush.Border}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="PART_TitleBar" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PART_TitleIcon" Width="18" Height="18" CornerRadius="{DynamicResource Toad.Radius.Check}"
                                            Margin="14,0,0,0" Background="{DynamicResource Toad.Brush.Accent}">
                                        <local:Icon Symbol="{TemplateBinding TitleIcon}" Width="12" Height="12" StrokeThickness="3"
                                                    Foreground="{DynamicResource Toad.Brush.OnAccent}"/>
                                    </Border>
                                    <TextBlock x:Name="Title" Grid.Column="1" Margin="10,0,10,0" Text="{TemplateBinding Title}"
                                               FontSize="{DynamicResource Toad.FontSize.Title}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ContentPresenter Grid.Column="2" Content="{TemplateBinding TitleBarContent}" VerticalAlignment="Center"
                                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button x:Name="PART_Minimize" Style="{StaticResource Toad.Style.CaptionButton}"
                                                Visibility="{Binding ShowMinimizeButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Toad.BooleanToVisibility}}">
                                            <local:Icon Symbol="Minus" Style="{StaticResource Toad.Style.CaptionIcon}"/>
                                        </Button>
                                        <Button x:Name="PART_Maximize" Style="{StaticResource Toad.Style.CaptionButton}"
                                                Visibility="{Binding ShowMaximizeButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Toad.BooleanToVisibility}}">
                                            <local:Icon x:Name="MaximizeIcon" Symbol="Square" Style="{StaticResource Toad.Style.CaptionIcon}"/>
                                        </Button>
                                        <Button x:Name="PART_Close" Style="{StaticResource Toad.Style.CloseButton}"
                                                Visibility="{Binding ShowCloseButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Toad.BooleanToVisibility}}">
                                            <local:Icon Symbol="X" Style="{StaticResource Toad.Style.CaptionIcon}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <AdornerDecorator Grid.Row="1">
                                    <ContentPresenter/>
                                </AdornerDecorator>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TitleIcon" Value="None">
                            <Setter TargetName="PART_TitleIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Title" Property="Margin" Value="14,0,10,0"/>
                        </Trigger>
                        <Trigger Property="Fill" Value="Background">
                            <Setter TargetName="PART_Frame" Property="Background" Value="{DynamicResource Toad.Brush.Background}"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_Frame" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="PART_Frame" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="MaximizeIcon" Property="Symbol" Value="Copy"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
