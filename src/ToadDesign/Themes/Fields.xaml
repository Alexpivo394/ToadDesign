<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ToadDesign">

    <!-- Validation errors are shown by the field's own border; no adorner rectangle. -->
    <ControlTemplate x:Key="Toad.Template.NoValidationAdorner">
        <AdornedElementPlaceholder/>
    </ControlTemplate>

    <Style x:Key="Toad.Style.FieldBase" TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource Toad.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Toad.FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Toad.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource Toad.Size.Control}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Toad.Template.NoValidationAdorner}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Toad.Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Toad.Brush.TextDimmed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Border states shared by every field template: focus (accent), error (danger) wins. -->
    <!-- WPF applies TextBox and PasswordBox Padding inside the text view as well; their 12 px inset is in the templates. -->
    <Style x:Key="Toad.Style.TextBoxBase" TargetType="TextBoxBase" BasedOn="{StaticResource Toad.Style.FieldBase}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Toad.Brush.Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
    </Style>

    <Style x:Key="Toad.Style.TextBox" TargetType="TextBox" BasedOn="{StaticResource Toad.Style.TextBoxBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Focus">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
                        </Trigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="12,8"/>
                            <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Toad.Style.TextBox}"/>

    <Style x:Key="Toad.Style.ToadTextBox" TargetType="local:TextBox" BasedOn="{StaticResource Toad.Style.TextBoxBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TextBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:Icon x:Name="PART_Icon" Symbol="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                        VerticalAlignment="Center" Foreground="{DynamicResource Toad.Brush.TextDimmed}"/>
                            <TextBlock x:Name="PART_Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" Visibility="Collapsed"
                                       Foreground="{DynamicResource Toad.Brush.TextDimmed}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Margin="2,0,0,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding TrailingContent}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Focus">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:TextBox" BasedOn="{StaticResource Toad.Style.ToadTextBox}"/>

    <!-- Standard PasswordBox: the field look. -->
    <Style x:Key="Toad.Style.PasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource Toad.Style.FieldBase}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Toad.Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Focus">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Toad.Style.PasswordBox}"/>

    <!-- The bare PasswordBox inside toad:PasswordBox. -->
    <Style x:Key="Toad.Style.InnerPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:PasswordBox}}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Toad.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Toad.Brush.Accent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toad.Style.ToadPasswordBox" TargetType="local:PasswordBox" BasedOn="{StaticResource Toad.Style.FieldBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PasswordBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Toad.Radius.Control}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:Icon x:Name="PART_Icon" Symbol="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                        VerticalAlignment="Center" Foreground="{DynamicResource Toad.Brush.TextDimmed}"/>
                            <TextBlock x:Name="PART_Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" Visibility="Collapsed"
                                       Foreground="{DynamicResource Toad.Brush.TextDimmed}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                            <PasswordBox x:Name="PART_PasswordBox" Grid.Column="1" Style="{StaticResource Toad.Style.InnerPasswordBox}" TabIndex="{TemplateBinding TabIndex}"
                                         IsEnabled="{TemplateBinding IsEnabled}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEmpty" Value="True">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="local:Theme.PreviewState" Value="Focus">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Focus}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Toad.Brush.Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:PasswordBox" BasedOn="{StaticResource Toad.Style.ToadPasswordBox}"/>

</ResourceDictionary>
